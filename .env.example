PORT=3555
NODE_ENV=development
FLOCI_ENDPOINT=http://localhost:4566

# JWT Auth Configuration
JWT_ENABLED=true
AGREEMENTS_JWT_SECRET=a-string-secret-at-least-256-bits-long
# FGP-1307: logical key id the default AGREEMENTS_JWT_SECRET is stored under, and
# the kid assumed when an incoming caller token carries no kid header (grants-ui).
AGREEMENTS_JWT_DEFAULT_KID=agreements-hs256-1
# FGP-1307: optional JSON object of extra verification secrets keyed by kid, for
# verifying tokens signed with a rotated key during a rotation overlap.
# AGREEMENTS_JWT_KEYRING={"agreements-hs256-2":"the-next-secret"}

# Temporary Woodland migration API (leave empty to disable)
WOODLAND_MIGRATION_TOKEN_HASH=

# MongoDB configuration
MONGO_URI=mongodb://localhost:27017/

# To enable local debugging
MONGO_REPLICA_HOST=localhost

SEED_DB=true

# SQS configuration
SQS_ENDPOINT=http://localhost:4566
QUEUE_URL=http://localhost:4566/000000000000/create_agreement_fifo.fifo
QUEUE_NAME=create_agreement_fifo.fifo
ENABLE_TEST_ENDPOINTS=true

# AWS configuration
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SNS configuration
TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:grant_application_approved_fifo.fifo
SNS_TOPIC_ARN_AUDIT=arn:aws:sns:eu-west-2:000000000000:fcp_audit_farming_grants_agreements_api

# S3 bucket configuration
S3_ENDPOINT=http://localhost:4568
FILES_S3_BUCKET=farming-grants-agreements-pdf-bucket
FILES_S3_PREFIX=agreements
FILES_S3_BASE_TERM_PREFIX=base
FILES_S3_EXTENDED_TERM_PREFIX=extended
FILES_S3_MAXIMUM_TERM_PREFIX=maximum

FILES_S3_BASE_TERM_THRESHOLD=10
FILES_S3_EXTENDED_TERM_THRESHOLD=15
FILES_S3_MAXIMUM_TERM_THRESHOLD=20

FILES_S3_RETENTION_BASE_YEARS=7

# PDF service configuration
VIEW_AGREEMENT_URI=http://localhost:3000

# Land Grants API configuration
LAND_GRANTS_TOKEN=
LAND_GRANTS_BASE_URL=http://localhost:3001

# Temp duplicate setting for backward compatability
LAND_GRANTS_CALCULATION_URI=/api/v2/payments/calculate

LAND_GRANTS_CALCULATION_URI_FPTT=/api/v2/payments/calculate
LAND_GRANTS_CALCULATION_URI_WMP=/api/v1/wmp/payments/calculate
